---
type IconName =
  | 'hammer'
  | 'brick'
  | 'trowel'
  | 'saw'
  | 'house'
  | 'house-plus'
  | 'paint'
  | 'wrench'
  | 'shield'
  | 'shield-check'
  | 'check'
  | 'cross'
  | 'arrow-right'
  | 'arrow-down'
  | 'phone'
  | 'mail'
  | 'pin'
  | 'menu'
  | 'close'
  | 'chevron-right'
  | 'chevron-left'
  | 'chevron-down'
  | 'document'
  | 'sparkles'
  | 'leaf'
  | 'star'
  | 'quote'
  | 'clock';

interface Props {
  name: IconName;
  class?: string;
  size?: number;
  strokeWidth?: number;
  ariaLabel?: string;
}

const { name, class: cls = '', size = 24, strokeWidth = 1.5, ariaLabel } = Astro.props;
const a11y = ariaLabel ? { role: 'img', 'aria-label': ariaLabel } : { 'aria-hidden': 'true' };
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={cls}
  {...a11y}
>
  {name === 'hammer' && (
    <>
      <path d="M14 4l6 6-2 2-6-6z"/>
      <path d="M11 7l-7 7 3 3 7-7"/>
      <path d="M12 13l4 4"/>
    </>
  )}
  {name === 'brick' && (
    <>
      <path d="M3 6h18v4H3z"/>
      <path d="M3 10v4h18v-4"/>
      <path d="M3 14v4h18v-4"/>
      <path d="M9 6v4M15 10v4M9 14v4"/>
    </>
  )}
  {name === 'trowel' && (
    <>
      <path d="M14 3l7 7-9 4-2-2 4-9z"/>
      <path d="M10 12l-7 7 1 1 7-7"/>
    </>
  )}
  {name === 'saw' && (
    <>
      <path d="M3 7l3 3 2-2 2 2 2-2 2 2 2-2 2 2 3-3"/>
      <path d="M3 7v3l16 0V7"/>
      <path d="M11 10v8l-3 3"/>
    </>
  )}
  {name === 'house' && (
    <>
      <path d="M3 12l9-8 9 8"/>
      <path d="M5 10v10h14V10"/>
      <path d="M10 20v-6h4v6"/>
    </>
  )}
  {name === 'house-plus' && (
    <>
      <path d="M3 11l9-8 9 8"/>
      <path d="M5 9v11h7"/>
      <path d="M19 9v4"/>
      <path d="M19 17v4M17 19h4"/>
    </>
  )}
  {name === 'paint' && (
    <>
      <path d="M5 3h12v4H5z"/>
      <path d="M5 7v4h12V7"/>
      <path d="M11 11v5"/>
      <path d="M9 16h4v5H9z"/>
    </>
  )}
  {name === 'wrench' && (
    <>
      <path d="M14.7 6.3a4 4 0 0 1-5.4 5.4L4 17l3 3 5.3-5.3a4 4 0 0 1 5.4-5.4l-2.5 2.5-2-2 2.5-2.5z"/>
    </>
  )}
  {name === 'shield' && (
    <>
      <path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6l8-3z"/>
    </>
  )}
  {name === 'shield-check' && (
    <>
      <path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6l8-3z"/>
      <path d="M9 12l2 2 4-4"/>
    </>
  )}
  {name === 'check' && (<><path d="M5 12l4 4 10-10"/></>)}
  {name === 'cross' && (<><path d="M6 6l12 12M18 6L6 18"/></>)}
  {name === 'arrow-right' && (
    <>
      <path d="M5 12h14"/>
      <path d="M13 6l6 6-6 6"/>
    </>
  )}
  {name === 'arrow-down' && (
    <>
      <path d="M12 5v14"/>
      <path d="M6 13l6 6 6-6"/>
    </>
  )}
  {name === 'phone' && (
    <>
      <path d="M5 4h3l2 5-2.5 1.5a11 11 0 0 0 6 6L15 14l5 2v3a2 2 0 0 1-2 2A15 15 0 0 1 3 6a2 2 0 0 1 2-2z"/>
    </>
  )}
  {name === 'mail' && (
    <>
      <path d="M3 6h18v12H3z"/>
      <path d="M3 7l9 7 9-7"/>
    </>
  )}
  {name === 'pin' && (
    <>
      <path d="M12 21s-7-6-7-12a7 7 0 1 1 14 0c0 6-7 12-7 12z"/>
      <circle cx="12" cy="9" r="2.5"/>
    </>
  )}
  {name === 'menu' && (<><path d="M4 7h16M4 12h16M4 17h16"/></>)}
  {name === 'close' && (<><path d="M6 6l12 12M18 6L6 18"/></>)}
  {name === 'chevron-right' && (<><path d="M9 6l6 6-6 6"/></>)}
  {name === 'chevron-left' && (<><path d="M15 6l-6 6 6 6"/></>)}
  {name === 'chevron-down' && (<><path d="M6 9l6 6 6-6"/></>)}
  {name === 'document' && (
    <>
      <path d="M7 3h8l4 4v14H7z"/>
      <path d="M15 3v4h4"/>
      <path d="M10 12h6M10 16h6"/>
    </>
  )}
  {name === 'sparkles' && (
    <>
      <path d="M12 4l1.5 4 4 1.5-4 1.5L12 15l-1.5-4-4-1.5 4-1.5z"/>
      <path d="M19 14l.7 2 2 .7-2 .7-.7 2-.7-2-2-.7 2-.7z"/>
    </>
  )}
  {name === 'leaf' && (
    <>
      <path d="M5 19c1-9 6-14 15-14-1 9-5 14-15 14z"/>
      <path d="M5 19c4-5 8-9 14-13"/>
    </>
  )}
  {name === 'star' && (
    <>
      <path d="M12 3l3 6 6 .9-4.5 4.4 1 6.2L12 17.5 6.5 20.5l1-6.2L3 9.9 9 9z"/>
    </>
  )}
  {name === 'quote' && (
    <>
      <path d="M6 8c-1.5 0-3 1.5-3 3.5S4.5 15 6 15v3l3-3v-7z"/>
      <path d="M16 8c-1.5 0-3 1.5-3 3.5s1.5 3.5 3 3.5v3l3-3v-7z"/>
    </>
  )}
  {name === 'clock' && (
    <>
      <circle cx="12" cy="12" r="9"/>
      <path d="M12 7v5l3 2"/>
    </>
  )}
</svg>
