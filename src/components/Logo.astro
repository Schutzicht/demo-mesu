---
interface Props {
  variant?: 'dark' | 'light' | 'flag';
  class?: string;
  hideWordmark?: boolean;
}
const { variant = 'dark', class: cls = '', hideWordmark = false } = Astro.props;
const isLight = variant === 'light';
const isFlag = variant === 'flag';

const markColor = isFlag ? '#FBF8F2' : (isLight ? '#F1ECE3' : '#15181C');
const wordColor = isLight ? '#F1ECE3' : '#15181C';
const subColor  = isLight ? 'rgba(241,236,227,.65)' : 'rgba(81,87,95,.85)';
---
<a href="/" class={`inline-flex items-center gap-3 group ${cls}`} aria-label="Aannemersbedrijf Mesu B.V., homepage">
  {/* AM stacked monogram, gebaseerd op de Mesu vlag */}
  <svg width="42" height="46" viewBox="0 0 42 46" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="shrink-0">
    {/* Letter A bovenkant */}
    <path
      d="M3 22 L21 1 L39 22 L33 22 L21 8 L9 22 Z"
      fill={markColor}
    />
    <rect x="12" y="16" width="18" height="3.6" fill={markColor} />
    {/* Letter M onderkant */}
    <path
      d="M3 23 L9 23 L21 36 L33 23 L39 23 L39 45 L33 45 L33 31 L21 44 L9 31 L9 45 L3 45 Z"
      fill={markColor}
    />
  </svg>

  {!hideWordmark && (
    <span class="leading-none" style={`font-family: var(--font-display); font-weight: 500;`}>
      <span class="block" style={`color: ${wordColor}; font-size: 1.02rem; letter-spacing: -0.012em;`}>Mesu</span>
      <span class="block mt-1" style={`color: ${subColor}; font-size: .58rem; letter-spacing: .26em; text-transform: uppercase; font-weight: 400; font-style: italic;`}>Aannemersbedrijf</span>
    </span>
  )}
</a>
