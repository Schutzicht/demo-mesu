---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { projects } from '../data/projects';

const categories = ['Alles', 'Nieuwbouw', 'Verbouw', 'Restauratie', 'Onderhoud', 'Interieur'];

const layoutMap = ['proj-cell--wide','proj-cell--tall','proj-cell--narrow','proj-cell--med','proj-cell--full','proj-cell--tall'];
const ratioMap  = ['16/9','3/4','4/5','4/3','16/8','3/4'];
---

<Layout title="Projecten - Mesu BV" active="projecten">
  {/* Hero */}
  <section class="relative hero-min-h overflow-hidden bg-ink text-ice">
    <img src="/img/project-2.jpg" alt="" class="hero-bg absolute inset-0 w-full h-full object-cover" onerror="this.style.display='none'"/>
    <div class="absolute inset-0 hero-veil" aria-hidden="true"></div>
    <div class="absolute inset-0 hero-veil-side" aria-hidden="true"></div>
    <div class="absolute top-0 right-0 bottom-0 w-[42%] pointer-events-none" aria-hidden="true" style="background: linear-gradient(225deg, rgba(181,68,61,.18) 0%, transparent 55%); mix-blend-mode: multiply;"></div>

    <div class="relative container-x hero-min-h flex flex-col pt-28 lg:pt-32 pb-10 lg:pb-14">
      <div class="flex-1 flex flex-col justify-end" data-reveal>
        <div class="sig-mark text-brick-soft mb-7">Recente projecten</div>
        <h1 class="editorial-1 text-ice max-w-[20ch]">
          Werk dat <span class="serif-italic text-brick-soft">zichzelf laat zien.</span>
        </h1>
        <p class="mt-7 max-w-xl text-ice/72 leading-relaxed">
          Een doorsnede van onze projecten in Zeeland. Van nieuwbouw in Veere tot een monumentale restauratie in Middelburg. Een vast aanspreekpunt bij elk project.
        </p>
      </div>
    </div>
  </section>

  {/* Filters */}
  <section class="bg-paper sticky top-16 lg:top-[78px] z-20 border-b border-ink/8">
    <div class="container-x py-3 lg:py-4 overflow-x-auto -mx-5 sm:-mx-7 px-5 sm:px-7">
      <div class="flex gap-5 lg:gap-8 min-w-max" id="project-filters">
        {categories.map((c, i) => (
          <button
            type="button"
            data-filter={c}
            class:list={[
              'text-[.84rem] serif-italic cursor-pointer transition-colors whitespace-nowrap',
              i === 0 ? 'is-active text-brick' : 'text-mortar hover:text-ink',
            ]}
          >
            {c}
          </button>
        ))}
      </div>
    </div>
  </section>

  {/* Projects grid */}
  <section class="relative bg-paper py-20 md:py-28 lg:py-36">
    <div class="container-x">
      <div class="proj-grid" id="project-grid">
        {projects.map((p, i) => (
          <article
            class:list={['proj-cell', layoutMap[i % layoutMap.length]]}
            data-cat={p.category}
            data-reveal
            data-reveal-delay={String((i % 3) + 1)}
          >
            <a href={`#${p.id}`} class="proj-tile frame block" style={`aspect-ratio: ${ratioMap[i % ratioMap.length]};`}>
              <img src={p.image} alt={p.title} loading="lazy" onerror="this.style.display='none'"/>
              <div class="proj-tile__meta">
                <div>
                  <div class="proj-tile__title">{p.title}</div>
                  <div class="caption text-ice/75 mt-1">{p.location}, {p.year}</div>
                </div>
                <span class="proj-tile__label">{p.category}</span>
              </div>
            </a>
            <div class="mt-4 pl-1 flex items-start justify-between gap-4">
              <p class="text-[.88rem] text-mortar leading-relaxed max-w-sm">{p.blurb}</p>
              <span class="caption text-mortar whitespace-nowrap">{p.year}</span>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* CTA */}
  <section class="relative bg-ink text-ice py-20 md:py-28 lg:py-36">
    <div class="container-x text-center max-w-3xl mx-auto" data-reveal>
      <div class="sig-mark text-brick-soft mx-auto justify-center mb-7">Uw project hier?</div>
      <h2 class="editorial-2 text-ice">
        Vertel ons wat <span class="serif-italic text-brick-soft">u in gedachten heeft.</span>
      </h2>
      <div class="mt-10 flex flex-wrap justify-center gap-x-8 gap-y-3">
        <a href="/contact" class="editorial-link text-ice">Vraag een offerte aan <Icon name="arrow-right" size={14} /></a>
      </div>
    </div>
  </section>
</Layout>

<script>
  function bindFilters() {
    const root = document.getElementById('project-filters');
    const grid = document.getElementById('project-grid');
    if (!root || !grid || root.dataset.bound === '1') return;
    root.dataset.bound = '1';
    const buttons = root.querySelectorAll<HTMLButtonElement>('button[data-filter]');
    const cards = grid.querySelectorAll<HTMLElement>('article[data-cat]');
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.dataset.filter || 'Alles';
        buttons.forEach((b) => {
          b.classList.toggle('is-active', b === btn);
          b.classList.toggle('text-brick', b === btn);
          b.classList.toggle('text-mortar', b !== btn);
        });
        cards.forEach((c) => {
          const match = filter === 'Alles' || c.dataset.cat === filter;
          c.style.display = match ? '' : 'none';
        });
      });
    });
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bindFilters);
  } else {
    bindFilters();
  }
  document.addEventListener('astro:page-load', bindFilters);
</script>
