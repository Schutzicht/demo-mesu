---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { bouwgarant } from '../data/company';
---

<Layout title="Garanties en BouwGarant - Mesu BV" active="garanties">
  {/* Hero */}
  <section class="relative hero-min-h overflow-hidden bg-ink text-ice">
    <img src="/img/service-restauratie.jpg" alt="" class="hero-bg absolute inset-0 w-full h-full object-cover opacity-50" onerror="this.style.display='none'"/>
    <div class="absolute inset-0" style="background: linear-gradient(135deg, rgba(79,107,137,.55) 0%, rgba(79,107,137,.1) 35%, rgba(181,68,61,.18) 65%, rgba(181,68,61,.55) 100%); mix-blend-mode: multiply;"></div>
    <div class="absolute inset-0" style="background: linear-gradient(180deg, rgba(21,24,28,.45) 0%, rgba(21,24,28,.6) 60%, rgba(21,24,28,.9) 100%);"></div>

    <div class="relative container-x hero-min-h flex flex-col pt-28 lg:pt-32 pb-10 lg:pb-14">
      <div class="flex-1 flex flex-col justify-end" data-reveal>
        <div class="sig-mark text-brick-soft mb-7">Garanties, keurmerken</div>
        <h1 class="editorial-1 text-ice max-w-[20ch]">
          Zekerheid op papier, <span class="serif-italic text-brick-soft">niet alleen op de bouw.</span>
        </h1>
        <p class="mt-7 max-w-xl text-ice/72 leading-relaxed">
          Aangesloten bij BouwGarant en lid van Bouwend Nederland. U werkt met een bedrijf dat aantoonbaar voldoet aan kwaliteits-, service- en garantie-eisen.
        </p>
      </div>
    </div>
  </section>

  {/* BouwGarant pijlers */}
  <section class="relative bg-paper py-20 md:py-28 lg:py-36 overflow-hidden">
    <div class="container-x relative">
      <div class="absolute -top-6 lg:-top-12 right-0 editorial-num">01</div>

      <div class="grid lg:grid-cols-12 gap-10 lg:gap-16 items-start">
        <div class="lg:col-span-5 lg:sticky lg:top-32" data-reveal>
          <div class="sig-mark text-brick mb-7">BouwGarant</div>
          <h2 class="editorial-2 text-ink">
            Het grootste keurmerk <span class="serif-italic">in de bouw.</span>
          </h2>
          <p class="mt-7 text-mortar leading-relaxed max-w-md">
            BouwGarant is een onafhankelijk keurmerk dat opdrachtgevers en bouwbedrijven aan elkaar verbindt op vier pijlers: kwaliteit, zekerheid, service en garantie.
          </p>
          <a href="https://www.bouwgarant.nl" target="_blank" rel="noopener" class="editorial-link text-ink mt-9">BouwGarant.nl <Icon name="arrow-right" size={14} /></a>
        </div>

        <div class="lg:col-span-7 grid gap-px bg-ink/12" data-reveal data-reveal-delay="1">
          {bouwgarant.map((b, i) => (
            <div class="bg-paper p-7 lg:p-9 grid grid-cols-[64px_1fr] gap-6 items-start">
              <div class="serif-italic text-brick text-[1.8rem] leading-none">0{i+1}</div>
              <div>
                <h3 class="editorial-3 text-ink">{b.title}</h3>
                <ul class="mt-4 grid gap-2">
                  {b.points.map((p) => (
                    <li class="flex items-start gap-3 text-[.92rem] text-ink/85"><span class="inline-block w-3 mt-2.5 h-px bg-brick shrink-0"></span><span>{p}</span></li>
                  ))}
                </ul>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  {/* Verbouw + nieuwbouw */}
  <section class="relative bg-paper-2 py-20 md:py-28 lg:py-36 overflow-hidden">
    <div class="container-x relative">
      <div class="absolute -top-6 lg:-top-12 left-0 editorial-num">02</div>

      <header class="relative mb-12 lg:mb-16" data-reveal>
        <div class="sig-mark text-brick mb-7">Aanvullende garanties</div>
        <h2 class="editorial-2 text-ink">
          VerBOUW, NieuwBOUW. <span class="serif-italic">Voor extra dekking.</span>
        </h2>
      </header>

      <div class="grid lg:grid-cols-2 gap-px bg-ink/12">
        {[
          {
            title: 'VerBOUWgarantie',
            tag: 'Voor verbouw',
            body: 'Bij grote en kleine verbouwingen kunt u de VerBOUWgarantie afsluiten. Een onafhankelijke verzekering bovenop onze eigen garanties, zodat u beschermd bent bij onverwachte gebeurtenissen.',
            points: ['Onafhankelijk geregeld', 'Geldt boven de aannemingsovereenkomst', 'Heldere voorwaarden vooraf'],
          },
          {
            title: 'NieuwBOUWgarantie',
            tag: 'Voor nieuwbouw',
            body: 'De NieuwBOUWgarantie is een onafhankelijke afbouw- en garantieverzekering voor nieuwbouwwoningen. Dekking voor zaken die binnen de garantietermijn aan het licht komen.',
            points: ['Afbouwgarantie tijdens bouw', 'Garantietermijn na oplevering', 'Onafhankelijke geschillenregeling'],
          },
        ].map((g) => (
          <article class="bg-paper-2 p-7 lg:p-10 flex flex-col" data-reveal>
            <div class="caption text-brick mb-3">{g.tag}</div>
            <h3 class="editorial-3 text-ink">{g.title}</h3>
            <p class="mt-5 text-mortar leading-relaxed text-[.96rem]">{g.body}</p>
            <ul class="mt-6 grid gap-2.5">
              {g.points.map((p) => (
                <li class="flex items-start gap-3 text-[.94rem] text-ink/85"><span class="inline-block w-3 mt-2.5 h-px bg-brick shrink-0"></span><span>{p}</span></li>
              ))}
            </ul>
            <a href="/contact" class="editorial-link text-ink mt-9 self-start">Bespreek de mogelijkheden <Icon name="arrow-right" size={14} /></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* Bouwend Nederland */}
  <section class="relative bg-paper py-20 md:py-28 lg:py-36 overflow-hidden">
    <div class="container-x relative">
      <div class="absolute -top-6 lg:-top-12 right-0 editorial-num">03</div>

      <div class="grid lg:grid-cols-12 gap-10 lg:gap-16 items-start">
        <div class="lg:col-span-5" data-reveal>
          <div class="sig-mark mb-7" style="color: var(--color-steel-deep)">Lid Bouwend Nederland</div>
          <h2 class="editorial-2 text-ink">
            De grootste ondernemers&shy;organisatie <span class="serif-italic">in de bouw.</span>
          </h2>
          <p class="mt-7 text-mortar leading-relaxed max-w-md">
            Bouwend Nederland verenigt ongeveer 4600 bouw- en infrabedrijven. Als lid zijn wij op de hoogte van actuele cao-, veiligheids- en kwaliteitsnormen.
          </p>
          <a href="https://www.bouwendnederland.nl" target="_blank" rel="noopener" class="editorial-link text-ink mt-9">Bouwendnederland.nl <Icon name="arrow-right" size={14} /></a>
        </div>
        <div class="lg:col-span-7 grid gap-px bg-ink/12" data-reveal data-reveal-delay="2">
          {[
            { t: 'Actuele branche-kennis', b: 'Wet- en regelgeving, cao en veiligheidsstandaarden.' },
            { t: 'Vakopleiding, jong talent', b: 'Investeren in nieuwe vakmensen voor de bouw.' },
            { t: 'Duurzaam bouwen', b: 'Toegang tot expertise rond verduurzaming en energietransitie.' },
          ].map((x, i) => (
            <div class="bg-paper p-7 lg:p-9 grid grid-cols-[64px_1fr] gap-6 items-start">
              <div class="serif-italic text-[1.8rem] leading-none" style="color: var(--color-steel-deep)">0{i+1}</div>
              <div>
                <h3 class="editorial-3 text-ink">{x.t}</h3>
                <p class="mt-3 text-[.94rem] text-mortar leading-relaxed">{x.b}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</Layout>
