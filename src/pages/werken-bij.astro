---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';

const vacancies = [
  {
    title: 'Ervaren timmerman',
    type: 'Fulltime, vast contract',
    location: 'Middelburg, regio Zeeland',
    body: 'Voor onze vaste verbouw- en restauratieploegen zoeken we een ervaren timmerman die zelfstandig werkt en jongere collega\'s mee opleidt. Je werkt zowel op locatie als af en toe in de werkplaats.',
    musts: ['Minimaal 5 jaar ervaring in renovatie of restauratie', 'Eigen rijbewijs B', 'Goed Nederlands, prettig in opdrachtgever-contact'],
  },
  {
    title: 'Aankomend metselaar',
    type: 'Fulltime of BBL, vast contract',
    location: 'Middelburg, regio Zeeland',
    body: 'Voor onze metsel- en voegwerk-ploeg zoeken we een aankomend metselaar. Begeleiding door Jasper en zijn ploeg, opleiding via BBL als je dat wilt.',
    musts: ['Eerste ervaring of motivatie om te leren', 'Fysiek werk geen probleem', 'Punctueel en oog voor detail'],
  },
  {
    title: 'Projectleider verbouw',
    type: 'Fulltime, vast contract',
    location: 'Middelburg, deels op locatie',
    body: 'Vanwege de groei van verbouwprojecten zoeken we een tweede projectleider. Je werkt zelfstandig op meerdere projecten tegelijk en bent het aanspreekpunt voor opdrachtgevers.',
    musts: ['HBO werk- en denkniveau', 'Ervaring met verbouw, renovatie of nieuwbouw', 'Vlot in contact, gestructureerd in plannen'],
  },
];
---

<Layout title="Werken bij Mesu - vacatures" active="werken">
  {/* Hero */}
  <section class="relative hero-min-h overflow-hidden bg-ink text-ice">
    <img src="/img/werken-bij-hero.jpg" alt="" class="hero-bg absolute inset-0 w-full h-full object-cover" onerror="this.style.display='none'"/>
    <div class="absolute inset-0 hero-veil" aria-hidden="true"></div>
    <div class="absolute inset-0 hero-veil-side" aria-hidden="true"></div>
    <div class="absolute top-0 right-0 bottom-0 w-[42%] pointer-events-none" aria-hidden="true" style="background: linear-gradient(225deg, rgba(181,68,61,.18) 0%, transparent 55%); mix-blend-mode: multiply;"></div>

    <div class="relative container-x hero-min-h flex flex-col pt-28 lg:pt-32 pb-10 lg:pb-14">
      <div class="flex-1 flex flex-col justify-end" data-reveal>
        <div class="sig-mark text-brick-soft mb-7">Werken bij Mesu</div>
        <h1 class="editorial-1 text-ice max-w-[18ch]">
          Vakwerk, met <span class="serif-italic text-brick-soft">vakmensen.</span>
        </h1>
        <p class="mt-7 max-w-xl text-ice/72 leading-relaxed">
          Wij zoeken bouwers die langer dan een seizoen blijven. Vaste contracten, eerlijk loon, een werkplaats om trots op te zijn, en collega\'s met decennia ervaring naast vers vakmanschap.
        </p>
        <div class="mt-10 flex flex-wrap gap-x-8 gap-y-3 items-center">
          <a href="#vacatures" class="editorial-link text-ice">Open vacatures <Icon name="arrow-right" size={14} /></a>
          <a href="mailto:info@mesubv.nl?subject=Open sollicitatie" class="editorial-link text-ice/65">Open sollicitatie <Icon name="arrow-right" size={14} /></a>
        </div>
      </div>
    </div>
  </section>

  {/* Waarom Mesu */}
  <section class="relative bg-paper py-20 md:py-28 lg:py-36 overflow-hidden">
    <div class="container-x relative">
      <div class="absolute -top-6 lg:-top-12 left-0 editorial-num">01</div>

      <header class="relative grid lg:grid-cols-12 gap-10 mb-16 lg:mb-20" data-reveal>
        <div class="lg:col-span-7">
          <div class="sig-mark text-brick mb-7">Waarom Mesu</div>
          <h2 class="editorial-2 text-ink">
            Een bedrijf waar mensen <span class="serif-italic">blijven.</span>
          </h2>
        </div>
      </header>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-12">
        {[
          { t: 'Vast contract', b: 'Mesu werkt niet met flex of uitzend. We zoeken mensen voor de lange termijn, en dat staat ook zo in het contract.' },
          { t: 'Eigen werkplaats', b: 'Geen gehuurde bouwkeet, maar een echte werkplaats aan de Wilgenhoekweg met goede gereedschappen en koffie op niveau.' },
          { t: 'Vakopleiding', b: 'BBL of cursussen worden door ons gefaciliteerd en betaald. We bouwen vakmensen op, ook intern.' },
          { t: 'Korte lijnen', b: 'Geen managementlagen. Je weet wie de beslissingen neemt en kan altijd binnenlopen.' },
        ].map((x, i) => (
          <div data-reveal data-reveal-delay={String((i % 4) + 1)}>
            <div class="serif-italic text-brick text-[1.8rem] mb-3 leading-none">0{i+1}</div>
            <h3 class="editorial-3 text-ink">{x.t}</h3>
            <p class="mt-3 text-mortar text-[.94rem] leading-relaxed">{x.b}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Vacatures */}
  <section id="vacatures" class="relative bg-paper-2 py-20 md:py-28 lg:py-36 overflow-hidden">
    <div class="container-x relative">
      <div class="absolute -top-6 lg:-top-12 right-0 editorial-num">02</div>

      <header class="relative mb-12 lg:mb-16" data-reveal>
        <div class="sig-mark text-brick mb-7">Open vacatures</div>
        <h2 class="editorial-2 text-ink">
          Drie posities, <span class="serif-italic">elk een vak op zich.</span>
        </h2>
      </header>

      <div class="grid gap-px bg-ink/12">
        {vacancies.map((v, i) => (
          <article class="bg-paper-2 p-7 lg:p-10 grid lg:grid-cols-[100px_minmax(0,1.2fr)_minmax(0,1fr)] gap-6 lg:gap-10" data-reveal data-reveal-delay={String((i % 3) + 1)}>
            <div class="serif-italic text-brick text-[2.6rem] lg:text-[3.4rem] leading-none">0{i+1}</div>
            <div>
              <h3 class="editorial-3 text-ink">{v.title}</h3>
              <div class="mt-2 caption text-mortar">{v.type} &middot; {v.location}</div>
              <p class="mt-5 text-mortar text-[.95rem] leading-relaxed">{v.body}</p>
            </div>
            <div class="flex flex-col gap-4">
              <ul class="grid gap-2.5 text-[.92rem] text-ink/85">
                {v.musts.map((m) => (
                  <li class="flex items-start gap-3"><span class="inline-block w-3 mt-2.5 h-px bg-brick shrink-0"></span><span>{m}</span></li>
                ))}
              </ul>
              <a href={`mailto:info@mesubv.nl?subject=Sollicitatie ${v.title}`} class="editorial-link text-ink mt-auto pt-2 self-start">Solliciteren <Icon name="arrow-right" size={14} /></a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* Open sollicitatie */}
  <section class="relative bg-ink text-ice py-20 md:py-28 lg:py-36 overflow-hidden">
    <div class="absolute inset-0 bg-grid opacity-20"></div>
    <div class="container-x relative grid lg:grid-cols-12 gap-10 lg:gap-16 items-center">
      <div class="lg:col-span-7" data-reveal>
        <div class="sig-mark text-brick-soft mb-7">Niets passends?</div>
        <h2 class="editorial-2 text-ice">
          Stuur ons toch een <span class="serif-italic text-brick-soft">bericht.</span>
        </h2>
        <p class="mt-7 text-ice/70 leading-relaxed max-w-xl">
          Wij nemen ook mensen aan zonder dat er een vacature openstaat, als we voelen dat je past. Een korte mail met wie je bent en wat je goed kan is genoeg.
        </p>
        <a href="mailto:info@mesubv.nl?subject=Open sollicitatie" class="editorial-link text-ice mt-9">info@mesubv.nl <Icon name="arrow-right" size={14} /></a>
      </div>
      <div class="lg:col-span-5 lg:pl-10" data-reveal data-reveal-delay="2">
        <div class="frame frame--light" style="aspect-ratio: 4/5;">
          <img src="/img/service-timmerwerk.jpg" alt="" class="w-full h-full object-cover" loading="lazy" onerror="this.style.display='none'"/>
        </div>
      </div>
    </div>
  </section>
</Layout>
