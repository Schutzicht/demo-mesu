---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';

const pijlers = [
  { t: 'Schilisolatie', b: 'Spouwmuur, dak en vloer. Vaak het meest effectieve eerste werk, met de snelste terugverdientijd.', range: 'TV vanaf 6 jaar' },
  { t: 'Glas, kozijnen', b: 'Vervangen van enkel of oud HR-glas door HR++ of triple, eventueel in eigen werkplaats-gemaakte kozijnen.', range: 'TV vanaf 10 jaar' },
  { t: 'Warmtepomp', b: 'Hybride of vol-elektrisch. In samenwerking met onze vaste installateurs, ook voor de bouwkundige inpassing.', range: 'TV vanaf 8 jaar' },
  { t: 'Zonnepanelen', b: 'Installatie inclusief dakopbouw en bekabeling. Op nieuw of bestaand dak.', range: 'TV vanaf 6 jaar' },
];

const subsidies = [
  { t: 'ISDE', b: 'Investeringssubsidie duurzame energie, voor isolatiemaatregelen en warmtepompen, particulier en zakelijk.' },
  { t: 'BENG', b: 'Bijna Energieneutrale Gebouwen, eisen voor nieuwbouw. Wij ontwerpen mee om hieraan te voldoen.' },
  { t: 'Provinciale regelingen', b: 'Zeeland heeft eigen aanvullende regelingen, vaak gekoppeld aan een energie-coach traject. Wij wijzen u de weg.' },
];
---

<Layout title="Verduurzaming - Mesu BV" active="duurzaam">
  {/* Hero */}
  <section class="relative hero-min-h overflow-hidden bg-ink text-ice">
    <img src="/img/verduurzaming-hero.jpg" alt="" class="hero-bg absolute inset-0 w-full h-full object-cover" onerror="this.style.display='none'"/>
    <div class="absolute inset-0 hero-veil" aria-hidden="true"></div>
    <div class="absolute inset-0 hero-veil-side" aria-hidden="true"></div>
    <div class="absolute top-0 right-0 bottom-0 w-[42%] pointer-events-none" aria-hidden="true" style="background: linear-gradient(225deg, rgba(181,68,61,.18) 0%, transparent 55%); mix-blend-mode: multiply;"></div>

    <div class="relative container-x hero-min-h flex flex-col pt-28 lg:pt-32 pb-10 lg:pb-14">
      <div class="flex-1 flex flex-col justify-end" data-reveal>
        <div class="sig-mark mb-7" style="color: var(--color-moss-soft)">Verduurzaming</div>
        <h1 class="editorial-1 text-ice max-w-[20ch]">
          Bouwen, voor het <span class="serif-italic" style="color: var(--color-moss-soft)">klimaat van morgen.</span>
        </h1>
        <p class="mt-7 max-w-xl text-ice/72 leading-relaxed">
          Duurzaam bouwen is niet een module bij Mesu, het is verweven met elk project. We werken stap voor stap, vanuit een eerlijke kosten-batenanalyse, niet vanuit verkooppraatjes.
        </p>
      </div>
    </div>
  </section>

  {/* Aanpak */}
  <section class="relative bg-paper py-20 md:py-28 lg:py-36 overflow-hidden">
    <div class="container-x relative">
      <div class="absolute -top-6 lg:-top-12 right-0 editorial-num">01</div>

      <header class="relative grid lg:grid-cols-12 gap-10 mb-16 lg:mb-20" data-reveal>
        <div class="lg:col-span-7">
          <div class="sig-mark mb-7" style="color: var(--color-moss-deep)">Onze aanpak</div>
          <h2 class="editorial-2 text-ink">
            Eerst meten, dan <span class="serif-italic">bouwen.</span>
          </h2>
        </div>
        <div class="lg:col-span-5 lg:pt-6 flex flex-col justify-end">
          <p class="text-mortar leading-relaxed max-w-md">
            We beginnen niet met een installatie te verkopen. We beginnen met een opname op locatie, een eerlijk advies wat het meeste effect heeft, en in welke volgorde.
          </p>
        </div>
      </header>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-10">
        {pijlers.map((p, i) => (
          <div class="border-t border-ink/12 pt-6" data-reveal data-reveal-delay={String((i % 4) + 1)}>
            <div class="serif-italic text-[1.7rem] leading-none mb-3" style="color: var(--color-moss-deep)">0{i+1}</div>
            <h3 class="editorial-3 text-ink">{p.t}</h3>
            <p class="mt-3 text-mortar text-[.92rem] leading-relaxed">{p.b}</p>
            <div class="mt-5 caption" style="color: var(--color-moss-deep)">{p.range}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Subsidies */}
  <section class="relative py-20 md:py-28 lg:py-36 overflow-hidden" style="background: var(--color-moss-deep); color: var(--color-cream);">
    <div class="absolute inset-0 bg-grid opacity-20"></div>
    <div class="container-x relative">
      <div class="grid lg:grid-cols-12 gap-10 lg:gap-16 items-start">
        <div class="lg:col-span-5 lg:sticky lg:top-32" data-reveal>
          <div class="sig-mark mb-7" style="color: var(--color-moss-soft)">Subsidies, regelingen</div>
          <h2 class="editorial-2" style="color: var(--color-cream)">
            We helpen <span class="serif-italic" style="color: var(--color-moss-soft)">de weg vinden.</span>
          </h2>
          <p class="mt-7 leading-relaxed max-w-md" style="color: rgba(251,248,242,.72)">
            Verduurzamen is in Nederland een doolhof van regelingen, eisen en termijnen. We werken nauw samen met een lokale energie-coach en helpen u bij de aanvraag.
          </p>
        </div>
        <div class="lg:col-span-7 grid gap-px" style="background: rgba(251,248,242,.12)" data-reveal data-reveal-delay="1">
          {subsidies.map((s, i) => (
            <div class="p-7 lg:p-9 grid grid-cols-[64px_1fr] gap-6 items-start" style="background: var(--color-moss-deep)">
              <div class="serif-italic text-[1.8rem] leading-none" style="color: var(--color-moss-soft)">0{i+1}</div>
              <div>
                <h3 class="editorial-3" style="color: var(--color-cream)">{s.t}</h3>
                <p class="mt-3 text-[.92rem] leading-relaxed" style="color: rgba(251,248,242,.72)">{s.b}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  {/* CTA */}
  <section class="relative bg-paper py-20 md:py-28 lg:py-36">
    <div class="container-x text-center max-w-3xl mx-auto" data-reveal>
      <div class="sig-mark text-brick mx-auto justify-center mb-7">Plan een gesprek</div>
      <h2 class="editorial-2 text-ink">
        Een opname op locatie, <span class="serif-italic">en een eerlijk advies.</span>
      </h2>
      <p class="mt-7 text-mortar leading-relaxed max-w-xl mx-auto">
        Het eerste gesprek en de opname zijn kosteloos. Daarna ontvangt u een fasering en kostenraming op maat, plus inzicht in subsidies waarvoor u in aanmerking komt.
      </p>
      <div class="mt-10 flex flex-wrap justify-center gap-x-8 gap-y-3">
        <a href="/contact" class="editorial-link text-ink">Vraag een opname aan <Icon name="arrow-right" size={14} /></a>
        <a href="tel:+31118613098" class="editorial-link text-mortar">0118 - 61 30 98 <Icon name="arrow-right" size={14} /></a>
      </div>
    </div>
  </section>
</Layout>
