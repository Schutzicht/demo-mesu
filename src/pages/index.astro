---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { services } from '../data/services';
import { projects } from '../data/projects';
import { company, stats, testimonials, bouwgarant } from '../data/company';
---

<Layout title="Aannemersbedrijf Mesu - Sinds 1978" active="">
  {/* ========================================================
       HERO, full-bleed editorial met brand flag overlay
       ======================================================== */}
  <section class="relative hero-min-h overflow-hidden bg-ink text-ice">
    <img
      src="/img/hero.jpg"
      alt="Restauratie van een Zeeuws gevelhuis bij blauw uur"
      class="hero-bg absolute inset-0 w-full h-full object-cover"
      onerror="this.style.display='none'"
    />
    {/* Brand-flag diagonale tint overlay */}
    <div class="absolute inset-0" aria-hidden="true">
      <div class="absolute inset-0" style="background: linear-gradient(135deg, rgba(79,107,137,.62) 0%, rgba(79,107,137,.18) 35%, rgba(181,68,61,.18) 65%, rgba(181,68,61,.55) 100%); mix-blend-mode: multiply;"></div>
      <div class="absolute inset-0" style="background: linear-gradient(180deg, rgba(21,24,28,.3) 0%, rgba(21,24,28,.55) 60%, rgba(21,24,28,.85) 100%);"></div>
    </div>

    <div class="relative container-x flex flex-col hero-min-h pt-28 lg:pt-32 pb-10 lg:pb-14">
      {/* top, vertical year mark */}
      <div class="hidden md:flex absolute top-32 right-7 lg:right-10 items-center" aria-hidden="true">
        <span class="year-mark text-ice">Sinds 1978</span>
      </div>

      <div class="flex-1 flex flex-col justify-end">
        <div data-reveal>
          <div class="sig-mark text-brick-soft mb-7 lg:mb-10">Aannemersbedrijf, Middelburg</div>
          <h1 class="editorial-1 text-ice max-w-[18ch]">
            Bouwen, verbouwen, <span class="serif-italic text-brick-soft">restaureren</span>, in Zeeland.
          </h1>
          <p class="mt-7 lg:mt-9 max-w-xl text-ice/72 leading-relaxed text-[1.02rem] lg:text-[1.06rem] font-light">
            Sinds 1978 werken wij in vaste ploegen, met een eigen timmerwerkplaats aan de Wilgenhoekweg, voor opdrachtgevers die kwaliteit en heldere afspraken belangrijker vinden dan de laagste prijs.
          </p>

          <div class="mt-9 lg:mt-12 flex flex-wrap items-center gap-x-8 gap-y-4">
            <a href="/contact" class="editorial-link text-ice">
              Plan een gesprek
              <Icon name="arrow-right" size={14} />
            </a>
            <a href="/projecten" class="editorial-link text-ice/65">
              Bekijk werk
              <Icon name="arrow-right" size={14} />
            </a>
          </div>
        </div>
      </div>

      {/* bottom hairline meta */}
      <div class="mt-10 lg:mt-16 flex flex-wrap items-end justify-between gap-y-3 gap-x-6 text-[.72rem] uppercase tracking-[.22em] text-ice/55">
        <span>BouwGarant, Bouwend Nederland</span>
        <span class="hidden sm:inline">Wilgenhoekweg 40, Middelburg</span>
        <a href={`tel:${company.phoneRaw}`} class="hover:text-ice transition-colors">{company.phone}</a>
      </div>
    </div>
  </section>

  {/* ========================================================
       MARQUEE editorial wordmark
       ======================================================== */}
  <section class="relative bg-paper border-y border-ink/12 py-6 lg:py-8 overflow-hidden">
    <div class="marquee text-ink">
      <div class="marquee__row">
        {[...Array(2)].map(() => (
          <>
            <span class="marquee__item">Renovatie</span>
            <span class="marquee__dot"></span>
            <span class="marquee__item">Nieuwbouw</span>
            <span class="marquee__dot"></span>
            <span class="marquee__item">Restauratie</span>
            <span class="marquee__dot"></span>
            <span class="marquee__item">Onderhoud</span>
            <span class="marquee__dot"></span>
            <span class="marquee__item">Machinaal timmerwerk</span>
            <span class="marquee__dot"></span>
            <span class="marquee__item">Badkamers, keukens</span>
            <span class="marquee__dot"></span>
          </>
        ))}
      </div>
    </div>
  </section>

  {/* ========================================================
       INTRO, narrative editorial
       ======================================================== */}
  <section class="relative bg-paper py-20 md:py-28 lg:py-36 overflow-hidden">
    <div class="container-x relative">
      <div class="absolute -top-6 lg:-top-12 right-0 editorial-num">01</div>

      <div class="grid lg:grid-cols-12 gap-10 lg:gap-16 items-start relative">
        <div class="lg:col-span-5" data-reveal>
          <div class="sig-mark text-brick mb-7">Wie wij zijn</div>
          <h2 class="editorial-2 text-ink">
            Een vak dat je niet leert <span class="serif-italic">in een cursus.</span>
          </h2>
        </div>

        <div class="lg:col-span-7 lg:pt-6 grid gap-5 text-mortar text-[1.02rem] leading-[1.7]" data-reveal data-reveal-delay="1">
          <p>
            Mesu is geen schaalvergroter en geen flexbedrijf. Sinds 1978 werken wij met dezelfde filosofie: een vast team vakmensen, een eigen timmerwerkplaats, korte lijnen, en opdrachtgevers die ons na een eerste project opnieuw bellen voor de volgende.
          </p>
          <p>
            Of het nu gaat om een aanbouw aan een woning in Middelburg, een complete renovatie van een dijkhuis in Domburg, of het restaureren van een 17e-eeuwse gevel in de binnenstad, het werk verdient dezelfde aandacht. Geen project is te klein, geen detail te onbelangrijk.
          </p>
        </div>
      </div>

      {/* editorial stats row */}
      <div class="mt-16 lg:mt-24 pt-10 lg:pt-14 border-t border-ink/12">
        <div class="stat-row text-ink" data-reveal>
          {stats.map((s) => (
            <div>
              <div class="stat-row__n">
                <span data-count={String(s.value)} data-suffix={s.suffix}>0</span>
              </div>
              <div class="stat-row__l">{s.label}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  {/* ========================================================
       DIENSTEN, editorial vertical list
       ======================================================== */}
  <section class="relative bg-paper-2 py-20 md:py-28 lg:py-36 overflow-hidden">
    <div class="container-x relative">
      <div class="absolute -top-6 lg:-top-12 left-0 editorial-num">02</div>

      <header class="relative grid lg:grid-cols-12 gap-10 mb-12 lg:mb-20" data-reveal>
        <div class="lg:col-span-7">
          <div class="sig-mark text-brick mb-7">Wat wij doen</div>
          <h2 class="editorial-2 text-ink">
            Zes vakken onder <span class="serif-italic">een dak.</span>
          </h2>
        </div>
        <div class="lg:col-span-5 lg:pt-6 flex flex-col justify-end">
          <p class="text-mortar leading-relaxed max-w-md">
            Door de breedte van het eigen team coordineren wij projecten zonder ze door te schuiven. Een vast aanspreekpunt, van de tekentafel tot de oplevering.
          </p>
        </div>
      </header>

      <div class="relative">
        {services.map((s, i) => (
          <a href={`/diensten#${s.id}`} class="service-row group">
            <div class="service-row__num">0{i + 1}</div>
            <div>
              <h3 class="editorial-3 text-ink">{s.title}</h3>
              <p class="mt-3 text-mortar leading-relaxed text-[.96rem] max-w-md">{s.short}</p>
              <div class="mt-5 editorial-link text-brick">
                Meer info <Icon name="arrow-right" size={14} />
              </div>
            </div>
            <div class="service-row__media frame">
              <img src={s.image} alt={s.title} loading="lazy" onerror="this.style.display='none'" />
            </div>
          </a>
        ))}
        <div class="border-t border-ink/12"></div>
      </div>
    </div>
  </section>

  {/* ========================================================
       SIGNATURE QUOTE
       ======================================================== */}
  <section class="relative bg-ink text-ice py-24 md:py-32 lg:py-40 overflow-hidden">
    <div class="absolute inset-0 bg-grid opacity-20"></div>
    <div class="absolute top-1/2 -translate-y-1/2 -right-32 w-[480px] h-[480px] rounded-full" style="background: radial-gradient(circle, rgba(185,74,31,.14) 0%, transparent 70%)"></div>

    <div class="container-x relative">
      <div class="max-w-4xl">
        <span class="editorial-quote-mark block mb-2" aria-hidden="true">&ldquo;</span>
        <p class="editorial-quote text-ice" data-reveal>
          We werken liever 45 jaar voor 200 gezinnen, dan een jaar voor 9000.
        </p>
        <div class="mt-10 lg:mt-12 flex items-center gap-5" data-reveal data-reveal-delay="2">
          <div class="rule-thin bg-brick-soft" style="width:48px"></div>
          <div>
            <div class="serif-italic text-[1.05rem] text-ice">Familie Mesu</div>
            <div class="caption text-ice/55 mt-0.5">Eigenaren, sinds 1978</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ========================================================
       PROJECTEN, asymmetric editorial grid
       ======================================================== */}
  <section class="relative bg-paper py-20 md:py-28 lg:py-36 overflow-hidden">
    <div class="container-x relative">
      <div class="absolute -top-6 lg:-top-12 right-0 editorial-num">03</div>

      <header class="relative grid lg:grid-cols-12 gap-10 mb-12 lg:mb-20" data-reveal>
        <div class="lg:col-span-7">
          <div class="sig-mark text-brick mb-7">Recente projecten</div>
          <h2 class="editorial-2 text-ink">
            Werk dat zichzelf, <span class="serif-italic">doorvertelt.</span>
          </h2>
        </div>
        <div class="lg:col-span-5 lg:pt-6 flex items-end justify-start lg:justify-end">
          <a href="/projecten" class="editorial-link text-ink">
            Alle projecten <Icon name="arrow-right" size={14} />
          </a>
        </div>
      </header>

      <div class="proj-grid">
        <a href={`/projecten#${projects[0].id}`} class="proj-cell proj-cell--wide frame proj-tile" style="aspect-ratio: 16/9;" data-reveal>
          <img src={projects[0].image} alt={projects[0].title} loading="lazy" onerror="this.style.display='none'" />
          <div class="proj-tile__meta">
            <div>
              <div class="proj-tile__title">{projects[0].title}</div>
              <div class="caption text-ice/75 mt-1">{projects[0].location}, {projects[0].year}</div>
            </div>
            <span class="proj-tile__label">{projects[0].category}</span>
          </div>
        </a>

        <a href={`/projecten#${projects[1].id}`} class="proj-cell proj-cell--tall frame proj-tile" style="aspect-ratio: 3/4;" data-reveal data-reveal-delay="1">
          <img src={projects[1].image} alt={projects[1].title} loading="lazy" onerror="this.style.display='none'" />
          <div class="proj-tile__meta">
            <div>
              <div class="proj-tile__title">{projects[1].title}</div>
              <div class="caption text-ice/75 mt-1">{projects[1].location}, {projects[1].year}</div>
            </div>
            <span class="proj-tile__label">{projects[1].category}</span>
          </div>
        </a>

        <a href={`/projecten#${projects[2].id}`} class="proj-cell proj-cell--narrow frame proj-tile" style="aspect-ratio: 4/5;" data-reveal>
          <img src={projects[2].image} alt={projects[2].title} loading="lazy" onerror="this.style.display='none'" />
          <div class="proj-tile__meta">
            <div>
              <div class="proj-tile__title">{projects[2].title}</div>
              <div class="caption text-ice/75 mt-1">{projects[2].location}, {projects[2].year}</div>
            </div>
            <span class="proj-tile__label">{projects[2].category}</span>
          </div>
        </a>

        <a href={`/projecten#${projects[3].id}`} class="proj-cell proj-cell--med frame proj-tile" style="aspect-ratio: 4/3;" data-reveal data-reveal-delay="1">
          <img src={projects[3].image} alt={projects[3].title} loading="lazy" onerror="this.style.display='none'" />
          <div class="proj-tile__meta">
            <div>
              <div class="proj-tile__title">{projects[3].title}</div>
              <div class="caption text-ice/75 mt-1">{projects[3].location}, {projects[3].year}</div>
            </div>
            <span class="proj-tile__label">{projects[3].category}</span>
          </div>
        </a>

        <a href={`/projecten#${projects[4].id}`} class="proj-cell proj-cell--full frame proj-tile" style="aspect-ratio: 16/8;" data-reveal>
          <img src={projects[4].image} alt={projects[4].title} loading="lazy" onerror="this.style.display='none'" />
          <div class="proj-tile__meta">
            <div>
              <div class="proj-tile__title">{projects[4].title}</div>
              <div class="caption text-ice/75 mt-1">{projects[4].location}, {projects[4].year}</div>
            </div>
            <span class="proj-tile__label">{projects[4].category}</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  {/* ========================================================
       WAT KOST HET
       ======================================================== */}
  <section class="relative bg-paper-2 py-20 md:py-28 lg:py-36 overflow-hidden">
    <div class="container-x relative">
      <div class="absolute -top-6 lg:-top-12 left-0 editorial-num">04</div>

      <header class="relative grid lg:grid-cols-12 gap-10 mb-12 lg:mb-16" data-reveal>
        <div class="lg:col-span-7">
          <div class="sig-mark text-brick mb-7">Wat kost het</div>
          <h2 class="editorial-2 text-ink">
            Eerlijke indicaties, <span class="serif-italic">geen verrassingen.</span>
          </h2>
        </div>
        <div class="lg:col-span-5 lg:pt-6 flex flex-col justify-end">
          <p class="text-mortar leading-relaxed max-w-md">
            De prijs van een project hangt af van veel keuzes. Hieronder een bandbreedte voor terugkerende werkzaamheden, om grip te geven voor een eerste gesprek.
          </p>
        </div>
      </header>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-10" data-reveal data-reveal-delay="1">
        {[
          { t: 'Aanbouw woning', sub: 'incl. fundering, casco, gevel', range: 'vanaf €1.850 / m²' },
          { t: 'Totaalrenovatie', sub: 'sloop, installatie, afwerking', range: 'vanaf €1.450 / m²' },
          { t: 'Badkamer renovatie', sub: 'tegelwerk, sanitair, installatie', range: '€18 tot €32 duizend' },
          { t: 'Keuken renovatie', sub: 'tegelwerk, electra, plaatsing', range: '€14 tot €28 duizend' },
          { t: 'Restauratie gevel', sub: 'voegen, metselwerk, kozijnen', range: 'vanaf €450 / m²' },
          { t: 'Maatwerk kozijnen', sub: 'eigen werkplaats, op locatie geplaatst', range: 'op aanvraag' },
        ].map((p) => (
          <div class="border-t border-ink/12 pt-6">
            <div class="caption text-mortar mb-2">{p.sub}</div>
            <h3 class="editorial-3 text-ink">{p.t}</h3>
            <div class="mt-4 text-[1.4rem] lg:text-[1.6rem] text-brick" style="font-family: var(--font-display); font-weight: 400; letter-spacing: -0.015em;">{p.range}</div>
          </div>
        ))}
      </div>

      <div class="mt-12 lg:mt-16 flex flex-wrap items-center gap-x-8 gap-y-3 text-[.78rem] text-mortar leading-relaxed">
        <span class="serif-italic">*</span>
        <span>Indicatieve bandbreedtes, exclusief btw. Een definitieve prijs vraagt om een opname op locatie.</span>
        <a href="/contact" class="editorial-link text-ink">Vraag een opname aan <Icon name="arrow-right" size={14} /></a>
      </div>
    </div>
  </section>

  {/* ========================================================
       BOUWGARANT, editorial split
       ======================================================== */}
  <section class="relative bg-ink text-ice py-20 md:py-28 lg:py-36 overflow-hidden">
    <div class="absolute inset-0 bg-grid opacity-20"></div>
    <div class="container-x relative">
      <div class="absolute -top-6 lg:-top-12 right-0 editorial-num editorial-num--light">05</div>

      <div class="grid lg:grid-cols-12 gap-10 lg:gap-16 items-start">
        <div class="lg:col-span-5 lg:sticky lg:top-32" data-reveal>
          <div class="sig-mark text-brick-soft mb-7">Zekerheid op papier</div>
          <h2 class="editorial-2 text-ice">
            Aangesloten bij <span class="serif-italic text-brick-soft">BouwGarant.</span>
          </h2>
          <p class="mt-7 text-ice/70 leading-relaxed max-w-md">
            BouwGarant is het grootste keurmerk in de bouw. Voor opdrachtgevers betekent dit zekerheid op vier pijlers: kwaliteit, zekerheid, service en garantie. Voor extra dekking kunt u een VerBOUW- of NieuwBOUWgarantie afsluiten.
          </p>
          <a href="/garanties" class="editorial-link text-ice mt-9">Lees over garanties <Icon name="arrow-right" size={14} /></a>
        </div>

        <div class="lg:col-span-7 grid gap-px bg-cream/8" data-reveal data-reveal-delay="1">
          {bouwgarant.map((b, i) => (
            <div class="bg-ink p-7 lg:p-9 grid grid-cols-[80px_1fr] gap-6 items-start">
              <div>
                <div class="serif-italic text-brick-soft text-2xl">0{i+1}</div>
              </div>
              <div>
                <h3 class="editorial-3 text-ice">{b.title}</h3>
                <ul class="mt-4 grid gap-1.5">
                  {b.points.map((p) => (
                    <li class="flex items-start gap-3 text-[.92rem] text-ice/72 leading-relaxed">
                      <span class="inline-block w-3 mt-2.5 h-px bg-brick-soft shrink-0"></span>
                      <span>{p}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  {/* ========================================================
       TESTIMONIAL, single editorial
       ======================================================== */}
  <section class="relative bg-paper py-20 md:py-28 lg:py-36 overflow-hidden">
    <div class="container-x relative">
      <div class="grid lg:grid-cols-12 gap-10 lg:gap-16 items-center">
        <figure class="lg:col-span-6 lg:order-2" data-reveal>
          <div class="frame" style="aspect-ratio: 4/5;">
            <img src="/img/project-2.jpg" alt="Monumentale gevel Middelburg" class="w-full h-full object-cover" loading="lazy" onerror="this.style.display='none'"/>
          </div>
          <figcaption class="caption text-mortar mt-3">Monumentale gevel, Middelburg binnenstad. 2024.</figcaption>
        </figure>

        <div class="lg:col-span-6 lg:order-1" data-reveal data-reveal-delay="1">
          <span class="editorial-quote-mark block mb-2" aria-hidden="true">&ldquo;</span>
          <p class="editorial-quote text-ink">
            Mesu heeft onze monumentale gevel hersteld met oog voor detail. Het voegwerk en de kozijnen sluiten naadloos aan op het origineel.
          </p>
          <div class="mt-9 flex items-center gap-5">
            <div class="rule-thin bg-brick" style="width:48px"></div>
            <div>
              <div class="serif-italic text-[1.05rem] text-ink">Familie de Wolf</div>
              <div class="caption text-mortar mt-0.5">Particuliere opdrachtgever, Middelburg</div>
            </div>
          </div>
          <a href="/projecten" class="editorial-link text-ink mt-12">Bekijk meer projecten <Icon name="arrow-right" size={14} /></a>
        </div>
      </div>
    </div>
  </section>

  {/* ========================================================
       CTA, full-bleed editorial
       ======================================================== */}
  <section class="relative bg-ink text-ice overflow-hidden">
    <div class="absolute inset-0">
      <img src="/img/workshop.jpg" alt="" class="w-full h-full object-cover opacity-30" loading="lazy" onerror="this.style.display='none'"/>
      <div class="absolute inset-0" style="background: linear-gradient(90deg, var(--color-ink) 0%, rgba(21,24,28,.85) 60%, rgba(21,24,28,.4) 100%);"></div>
    </div>
    <div class="container-x relative py-20 md:py-32 lg:py-44">
      <div class="max-w-3xl" data-reveal>
        <div class="sig-mark text-brick-soft mb-7">Plannen aan het maken?</div>
        <h2 class="editorial-1 text-ice">
          Stuur uw plan, <br/><span class="serif-italic text-brick-soft">wij denken mee.</span>
        </h2>
        <p class="mt-7 text-ice/75 leading-relaxed max-w-xl">
          Een eerste gesprek op locatie is altijd kosteloos en vrijblijvend. Wij denken mee over haalbaarheid, planning en globale kosten.
        </p>
        <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4">
          <a href="/contact" class="editorial-link text-ice">Plan een gesprek<Icon name="arrow-right" size={14} /></a>
          <a href={`tel:${company.phoneRaw}`} class="editorial-link text-ice/65">{company.phone}<Icon name="arrow-right" size={14} /></a>
        </div>
      </div>
    </div>
  </section>
</Layout>
