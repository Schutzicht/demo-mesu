---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { team } from '../data/team';
---

<Layout title="Team - Aannemersbedrijf Mesu" active="team">
  {/* Hero */}
  <section class="relative hero-min-h overflow-hidden bg-ink text-ice">
    <img src="/img/workshop.jpg" alt="" class="hero-bg absolute inset-0 w-full h-full object-cover opacity-55" onerror="this.style.display='none'"/>
    <div class="absolute inset-0" style="background: linear-gradient(135deg, rgba(79,107,137,.55) 0%, rgba(79,107,137,.1) 35%, rgba(181,68,61,.18) 65%, rgba(181,68,61,.55) 100%); mix-blend-mode: multiply;"></div>
    <div class="absolute inset-0" style="background: linear-gradient(180deg, rgba(21,24,28,.4) 0%, rgba(21,24,28,.55) 60%, rgba(21,24,28,.88) 100%);"></div>

    <div class="relative container-x hero-min-h flex flex-col pt-28 lg:pt-32 pb-10 lg:pb-14">
      <div class="flex-1 flex flex-col justify-end" data-reveal>
        <div class="sig-mark text-brick-soft mb-7">Het team</div>
        <h1 class="editorial-1 text-ice max-w-[20ch]">
          De vakmensen <span class="serif-italic text-brick-soft">achter</span> Mesu.
        </h1>
        <p class="mt-7 max-w-xl text-ice/72 leading-relaxed">
          Een bedrijf is niet meer dan zijn mensen. Onze vaste ploeg, een doorsnede van ervaring en jong vakmanschap, op een rij.
        </p>
      </div>
    </div>
  </section>

  <section class="relative bg-paper py-20 md:py-28 lg:py-36 overflow-hidden">
    <div class="container-x relative">
      <div class="absolute -top-6 lg:-top-12 right-0 editorial-num">01</div>

      <div class="grid lg:grid-cols-2 gap-x-10 lg:gap-x-20 gap-y-20 lg:gap-y-28 relative">
        {team.map((m, i) => (
          <div class={`grid grid-cols-[1fr] sm:grid-cols-[1.1fr_1fr] gap-6 lg:gap-8 ${i % 2 === 1 ? 'lg:mt-24' : ''}`} data-reveal data-reveal-delay={String((i % 2) + 1)}>
            <div class="frame" style="aspect-ratio: 4/5;">
              <img src={m.image} alt={`${m.name}, ${m.role}`} class="w-full h-full object-cover" loading="lazy" onerror="this.style.display='none'"/>
            </div>
            <div class="flex flex-col justify-end pb-2">
              <div class="caption text-brick mb-3">Sinds {m.since}</div>
              <h2 class="editorial-3 text-ink">{m.name}</h2>
              <div class="serif-italic text-mortar mt-1 text-[.96rem]">{m.role}</div>
              <p class="mt-5 text-mortar leading-relaxed text-[.94rem]">{m.bio}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Werkplaats ode */}
  <section class="relative bg-ink text-ice py-20 md:py-28 lg:py-36 overflow-hidden">
    <div class="absolute inset-0 bg-grid opacity-20"></div>
    <div class="container-x relative grid lg:grid-cols-12 gap-10 lg:gap-16 items-center">
      <div class="lg:col-span-6" data-reveal>
        <div class="sig-mark text-brick-soft mb-7">Wat we waarderen</div>
        <h2 class="editorial-2 text-ice">
          Vakmensen <span class="serif-italic text-brick-soft">die blijven.</span>
        </h2>
        <div class="mt-9 grid gap-7 text-ice/72 leading-relaxed max-w-md">
          <p>De gemiddelde Mesu-vakman werkt al meer dan vijftien jaar in het bedrijf. Dat is bewust. Mensen die het werk en de klanten kennen, leveren beter werk.</p>
          <p>Daarom investeren we in opleiding van jonge mensen, in goede gereedschappen en in een werkplaats waar je trots op kunt zijn. We zoeken vakmensen, geen krachten.</p>
        </div>
        <a href="/werken-bij" class="editorial-link text-ice mt-9">Werken bij Mesu <Icon name="arrow-right" size={14} /></a>
      </div>
      <div class="lg:col-span-6" data-reveal data-reveal-delay="2">
        <div class="frame frame--light" style="aspect-ratio: 4/3;">
          <img src="/img/werken-bij-hero.jpg" alt="Mesu werkplaats" class="w-full h-full object-cover" loading="lazy" onerror="this.style.display='none'"/>
        </div>
        <div class="caption text-ice/55 mt-3">De ploeg, aan het einde van de werkdag.</div>
      </div>
    </div>
  </section>
</Layout>
