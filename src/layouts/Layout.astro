---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingCTA from '../components/FloatingCTA.astro';
import DemoIntro from '../components/DemoIntro.astro';

interface Props {
  title: string;
  description?: string;
  active?: string;
  hideHeader?: boolean;
  hideFooter?: boolean;
  hideCTA?: boolean;
}

const {
  title,
  description = 'Aannemersbedrijf Mesu BV in Middelburg. Nieuwbouw, verbouw, renovatie, restauratie, onderhoud en machinaal timmerwerk. BouwGarant aangesloten.',
  active = '',
  hideHeader = false,
  hideFooter = false,
  hideCTA = false,
} = Astro.props;
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#15181C" />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%234F6B89'/%3E%3Cpath d='M9 0 L32 0 L32 32 L3 32 Z' fill='%23B5443D'/%3E%3Cpath d='M5 14 L16 4 L27 14 L23 14 L16 8 L9 14 Z' fill='white'/%3E%3Crect x='10' y='11' width='12' height='2' fill='white'/%3E%3Cpath d='M5 15 L9 15 L16 22 L23 15 L27 15 L27 28 L23 28 L23 20 L16 27 L9 20 L9 28 L5 28 Z' fill='white'/%3E%3C/svg%3E"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@200;300;400;500;600;700&family=Inter:wght@300;400;500;600&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@200;300;400;500;600;700&family=Inter:wght@300;400;500;600&display=swap"
        rel="stylesheet"
      />
    </noscript>
    <ClientRouter />
    <slot name="head" />
  </head>
  <body>
    {!hideHeader && <Header active={active} />}

    <main id="main">
      <slot />
    </main>

    {!hideFooter && <Footer />}
    {!hideCTA && <FloatingCTA />}
    <DemoIntro />

    <script>
      function initReveal() {
        const els = document.querySelectorAll<HTMLElement>('[data-reveal]:not(.is-visible)');
        if (!els.length) return;
        if (!('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: '0px 0px -50px 0px' }
        );
        els.forEach((el) => io.observe(el));
      }

      function initCounters() {
        const els = document.querySelectorAll<HTMLElement>('[data-count]:not(.is-counted)');
        if (!els.length || !('IntersectionObserver' in window)) {
          els.forEach((el) => {
            const target = Number(el.dataset.count || '0');
            el.textContent = formatCount(target, el.dataset.suffix || '');
            el.classList.add('is-counted');
          });
          return;
        }
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            const el = e.target as HTMLElement;
            const target = Number(el.dataset.count || '0');
            const suffix = el.dataset.suffix || '';
            const duration = 1400;
            const start = performance.now();
            function tick(now: number) {
              const t = Math.min(1, (now - start) / duration);
              const eased = 1 - Math.pow(1 - t, 3);
              el.textContent = formatCount(Math.round(target * eased), suffix);
              if (t < 1) requestAnimationFrame(tick);
            }
            requestAnimationFrame(tick);
            el.classList.add('is-counted');
            io.unobserve(el);
          }
        }, { threshold: 0.5 });
        els.forEach((el) => io.observe(el));
      }

      function formatCount(n: number, suffix: string) {
        return n.toLocaleString('nl-NL') + suffix;
      }

      function bind() {
        initReveal();
        initCounters();
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', bind);
      } else {
        bind();
      }
      document.addEventListener('astro:page-load', bind);
    </script>
  </body>
</html>
